{
  "id": "agent-firewall",
  "name": "Agent Firewall",
  "description": "Evaluate tool calls with a local Agent Firewall policy before execution.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "policy",
      "workspace"
    ],
    "properties": {
      "binary": {
        "type": "string",
        "default": "agent-firewall"
      },
      "policy": {
        "type": "string"
      },
      "workspace": {
        "type": "string"
      },
      "dataDir": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 15000,
        "default": 5000
      }
    }
  }
}
